	]
	quest.4564BE69E51A90A4.quest_subtitle: "Difficulty50"
	quest.473CA38006F3C4A4.quest_desc: ["Once you craft a 30-minute {item.minecraft.potion.effect.apothic_attributes.flying}, you can use it to craft {item.minecraft.elytra}"]
	quest.488961A673AFA318.quest_desc: [
		"Very small chance to obtain from loot chests"
		""
		"Maids will drop &c{item.touhou_little_maid.film}&r upon death"
		""
		"Can be placed in &6{block.touhou_little_maid.shrine}&r to revive by consuming player health, or revived through rituals"
	]
	quest.48EF078682A042D6.title: "Producer for All"
	quest.492D4709E52D0C97.quest_desc: ["Upon consumption, restores 2 hunger points and 2.4 saturation, while also recovering stamina equal to a percentage of the maximum stamina."]
	quest.49C7F3D4FE51C089.quest_subtitle: "Allows players to teleport between two points"
	quest.49C7F3D4FE51C089.title: "Portal"
	quest.4A85185CDE1A7AD2.quest_desc: [
		"Located within the &aOverworld&r at the &3&lFrosted Prison&r&r"
		"Structure ID: cataclysm:frosted_prison"
	]
	quest.4A85185CDE1A7AD2.quest_subtitle: "Difficulty600"
	quest.4AF0160AB01B5304.quest_desc: [
		"Standing in the fluid of &6{item.hotbath.peony_bath_bucket}&r will restore health at a rate of 0.25 every 2 seconds."
		"After standing in the fluid of &6{item.hotbath.peony_bath_bucket}&r for 15 seconds, all negative status effects will be removed."
		"After standing in the fluid of &6{item.hotbath.peony_bath_bucket}&r for 15 seconds, you will gain 0.05 knockback resistance, lasting for 30 seconds."
		"After standing in the fluid of &6{item.hotbath.peony_bath_bucket}&r for 15 seconds, your attack speed will increase by 10%, lasting for 15 seconds."
		"After soaking a total of 50 times, each subsequent soak will grant a Level 1 &6{effect.minecraft.luck}&r effect, lasting for 45 seconds."
	]
	quest.4B3863244FB807C3.quest_desc: [
		"&6{item.minecraft.potion.effect.apothic_attributes.flying}&r"
		""
		"It will replace the generation of {item.minecraft.elytra} in the &c{End Ship}&r."
		"Honestly, creative flight is much more useful than {item.minecraft.elytra}."
		"If you want to experience the feel of {item.minecraft.elytra}, you can also use two bottles of &d30&r-minute {item.minecraft.potion.effect.apothic_attributes.flying} to craft {item.minecraft.elytra}."
		""
		"&c{End Ship}&r item generation probabilities:"
		"- &d8-minute {item.minecraft.potion.effect.apothic_attributes.flying}&r 33.3%"
		"- Strong Haste Potion 33.3%"
		"- &c{block.minecraft.netherite_block}&r 16.7%"
		"- {block.minecraft.diamond_block} 8.6%"
		"- &e{book.umapyoi.trainers_manual.title}&r 8.6%"
		"- Others"
	]
	quest.4CB753DB3E3039CD.quest_desc: [
		"Place your &e{item.umapyoi.uma_soul}&r into the {block.umapyoi.register_lectern}"
		""
		"Your {UmaMusu}'s attributes will be &6greatly enhanced&r"
		"At the same time, you will gain the Will of a {UmaMusu}"
	]
	quest.4D76E3D866F31784.quest_desc: [
		"Allows quick mailing of items between players."
		"Place and name a &eMailbox&r, then use the &bMail System&r to send items to the corresponding &eMailbox&r."
		""
		"Transporting containers or items with large NBT data is not allowed."
	]
	quest.4D967AC9E5045DDB.quest_desc: [
		"&c{block.mynethersdelight.powdery_cannon}&r does not spawn naturally; it is obtained by collecting the roots of &c{block.mynethersdelight.powdery_cane}&r."
		""
		"&c{block.mynethersdelight.powdery_cane}&r producing &c{block.mynethersdelight.bullet_pepper}&r at the tip spawns naturally in crimson forests; production of &c{block.mynethersdelight.bullet_pepper}&r triggers a crossbow sound. &c{block.mynethersdelight.bullet_pepper}&r explodes upon being touched or broken (&c{block.mynethersdelight.bullet_pepper}&r produced on &c{block.mynethersdelight.powdery_cannon}&r has a greater power, and can destroy itself with explosion)."
		""
		"Destroying &c{block.mynethersdelight.powdery_cane}&r other than the root gives &c{item.minecraft.stick}&r. Planting &c{block.mynethersdelight.bullet_pepper}&r produces new &c{block.mynethersdelight.powdery_cane}&r, and &c{block.mynethersdelight.powdery_cannon}&r can be obtained only after its root becomes sturdy. Destroying any part of &c{block.mynethersdelight.powdery_cannon}&r gives &c{block.mynethersdelight.powdery_cannon}&r."
	]
	quest.4E221A3F92D840AB.quest_desc: [
		"You can use &2{book.umapyoi.trainers_manual.title}&r to craft &d{item.umapyoi.blank_ticket}&r"
		""
		"This is an important item that will be needed later"
	]
	quest.4E6B6B368A8A4EA6.quest_desc: [
		"Craft an &e{item.pandora.pandora_bracelet}&r together with an &a{item.l2hostility.charm_of_looting_1}&r"
		"Insert the &a{item.l2hostility.charm_of_looting_1}&r into the &e{item.pandora.pandora_bracelet}&r"
		"Defeat enemies to obtain more loot (details can be checked in JEI)"
		"Craft more orbs to gain more and better loot"
	]
	quest.4EE2DA5EC1E8572B.quest_desc: [
		"{block.kubejs.warped_stem_chlorophyte} is hidden inside {block.minecraft.warped_stem} in the warped forest"
		"It is very hard and difficult to mine with an axe."
		"However, it is very fragile against explosions. You can use &cTNT&r or lure a &2{entity.minecraft.creeper}&r to explode near it"
		"It will directly drop &a{item.kubejs.chlorophyte_ingot}&r"
	]
	quest.4EE2DA5EC1E8572B.title: "Observe {block.kubejs.warped_stem_chlorophyte}"
	quest.4F64FB65FFEA050C.quest_subtitle: "Now Start Gluing"
	quest.4FC1C7D438B19492.quest_desc: [
		"Collect two Wills of {UmaMusu} and place them into the {block.umapyoi.three_goddess}"
		""
		"The Will of {UmaMusu} will serve as a stud to breed the next generation of {UmaMusu}"
		""
		"The stronger the stud, the more powerful the next generation of {UmaMusu} will be"
	]
	quest.4FD79173051DDEB8.quest_desc: ["Upon consumption, restores 2 hunger points and 2.4 saturation, while also recovering stamina equal to a percentage of the maximum stamina."]
	quest.5083B5F89464A522.quest_desc: [
		"In the {End Ice Spikes}, you can occasionally find some abandoned churches"
		"Frost Spiders have made their nests here, laying eggs and falling into hibernation"
		"If you &cbreak&r the frost protection layer around the Frost Spider eggs"
		"You will awaken the &lFrost Spider&r Guardians"
		""
		"Be careful! They are extremely dangerous!"
		"But the rewards are also very generous — the &lFrost Spiders&r have a chance to carry &brare equipment&r as well as &4{item.irons_spellbooks.cinderous_soulcaller}&r"
		"Defeat them to claim your prize!"
		""
		"Difficulty Level: 200+"
	]
	quest.513BC9A3564D299E.quest_subtitle: "Can be used with chassis or super glue, makes blocks act as entities when working"
	quest.51793B81F3FE45CE.quest_desc: ["During the day, it automatically engages in non-limited transactions with villagers."]
	quest.5283E81D31BE83AB.quest_desc: [
		"This weapon usually cannot deal damage, only knockback."
		"Deals damage to arthropods"
	]
	quest.5283E81D31BE83AB.quest_subtitle: "Six Hits per Second"
	quest.52A28F0788814240.quest_desc: [
		"This is the most &limportant&r drop from &d{entity.irons_spellbooks.dead_king}&r!"
		""
		"It will guide you onto the path of magic"
		"You first need to find a &5{block.irons_spellbooks.brazier_soul}&r in {dimension.minecraft.the_end}"
	]
	quest.534C36E4439EB3C7.quest_subtitle: "Defeat a maid in Chinese Chess"
	quest.53C14996CDBA5DC2.quest_desc: [
		"Throw the {item.irons_spellbooks.chained_book} into the &5{block.irons_spellbooks.brazier_soul}&r"
		"You will obtain a random &dMagic Scroll&r"
		"Equip it in your trinket slot, and it will automatically cast when you attack"
		""
		"&oNote! &dMagic Scrolls&r will drop upon death!&r"
	]
	quest.53C14996CDBA5DC2.title: "Observe “{block.irons_spellbooks.brazier_soul}”"
	quest.548EEBA7C16661D6.quest_desc: [
		"Equipment made from {item.l2complements.totemic_gold_ingot} has the quality of diamond and the enchantability of gold. As tools, their durability is close to diamond items, with mining speed similar to gold, but still at the diamond mining level. When crafting tools with {item.l2complements.totemic_gold_ingot} as the handle material and emerald as the head material, the durability is relatively high."
		""
		"Life Armor Effect: Every 5 seconds, each piece of armor restores 1 health point."
		""
		"Common effect of Life Equipment: When durability is consumed, &a restore the same amount of health&r, immune to hunger, wither, and poison effects."
		""
		"Therefore, Life Equipment is not suitable for using durability enchantments."
		"Life Armor can use armor durability enchantments to increase endurance, or use the {enchantment.l2complements.life_mending} enchantment to achieve a cycle of durability loss → health recovery → durability restoration, &6 making it so that as long as it is not destroyed in one hit, it can fully restore durability&r. With the addition of the {enchantment.l2complements.safeguard} enchantment, even one-hit destruction will no longer occur. No matter how much durability is lost, 1 point will remain, and then durability will be fully restored through {enchantment.l2complements.life_mending}. The only concern is potion effects that prevent health recovery."
		"{@pagebreak}"
		"Tools made from {item.l2complements.totemic_gold_ingot} have the quality of diamond and the enchantability of gold. As tools, their durability is close to diamond items, with mining speed similar to gold, but still at the diamond mining level."
	]
	quest.54931F97C140412D.quest_desc: ["Hot springs occasionally generate in the Overworld, and once found, they can be used infinitely."]
	quest.54931F97C140412D.title: "Hot Spring"
	quest.552F937D15E04A15.quest_desc: [
		"Standing in the fluid of &6{item.hotbath.honey_bath_bucket}&r will restore health at a rate of 0.25 per second."
		"Standing in the fluid of &6{item.hotbath.honey_bath_bucket}&r will grant Level 1 Slowness for 10 seconds."
		"After standing in the fluid of &6{item.hotbath.honey_bath_bucket}&r for 15 seconds, all negative status effects will be removed except &c{effect.minecraft.slowness}&r and &c{effect.minecraft.unluck}&r."
		"Standing in the fluid of &6{item.hotbath.honey_bath_bucket}&r will restore hunger at a rate of 1 every 4 seconds."
		"After standing in the fluid of &6{item.hotbath.honey_bath_bucket}&r for 15 seconds, you will gain Level 2 &6{effect.minecraft.absorption}&r, lasting for 20 seconds."
	]
	quest.55A6F9F0BC4D0096.quest_desc: [""]
	quest.56469F8456C022EF.quest_desc: ["Allows the player to quickly return to the bed or spawn point (cannot be used in &dThe End&r)."]
	quest.5655FD8F2B8FB4D2.quest_desc: ["Consuming {item.umapyoi.hachimi_big} increases Mood Level by 2 and restores 4 hunger points and 7 saturation."]
	quest.5655FD8F2B8FB4D2.quest_subtitle: "Can be consumed even at full hunger"
	quest.568DB1FCA0026DB0.quest_desc: ["The camera can capture a tamed maid. Players can right-click within 8 blocks of the maid to capture and create a photo."]
	quest.591763149B3E9648.title: "Traveling Tool"
	quest.592017A5227B6679.quest_desc: [
		"Use &6{block.create_hypertube.hypertube}&r to link &a{block.create_hypertube.hypertube_entrance}&r, and connect &c{create.display_source.kinetic_stress.current}&r to create a tunnel for player movement."
		""
		"This tunnel considerable pressure on frame rate, so use with discretion."
	]
	quest.592017A5227B6679.quest_subtitle: "A stylish short-distance travel method"
	quest.593E1782EC446B28.quest_desc: [
		"{UmaMusu} is an &e&litem&r&r that greatly enhances player attributes"
		"You can even cultivate an {UmaMusu} that &eincreases player attack power by 600%&r"
		""
		"You can find &2{book.umapyoi.trainers_manual.title}&r in chests within {dimension.minecraft.the_end}"
		"It serves as the gameplay guide for the “{itemGroup.umapyoi}” mod"
		""
		"Of course, you can also follow this quest book to learn how to play with {UmaMusu}"
	]
	quest.5AD85A669E436FAD.quest_desc: ["&z这世上再也没有什么能伤害到你&r"]
	quest.5AD85A669E436FAD.quest_subtitle: "苦尽甘来，超脱万物"
	quest.5C9F0C22F503C49A.quest_desc: [
		"Have you ever played 《{Terraria}》 on &cMaster&r difficulty?"
		""
		"&lIt requires you to carefully choose attack and health boosts, use flexible controls, rely on your knowledge of monsters, and complete the first clear with the help of many buff potions&r"
		""
		"The difficulty of this modpack’s adventure content is aligned with 《{Terraria}》 &cMaster&r difficulty."
		"If you have not yet played 《{Terraria}》 on &cMaster&r difficulty, I recommend choosing &aEasy Mode&r and enabling &aKeep Inventory&r to experience the adventure content."
		""
		"The command to enable Keep Inventory is:"
		"/gamerule keepInventory true"
		""
		"Before release, this modpack was tested three times on Easy, Normal, and Hard difficulties. All of them can clear the {dimension.minecraft.the_end} adventure content."
	]
	quest.5C9F0C22F503C49A.title: "Difficulty Tips"
	quest.5E7426AF846024EE.quest_desc: [
		"{item.l2complements.poseidite_ingot} equipment increases armor, armor toughness, movement speed, and swimming speed when underwater."
		""
		"Helmets and chestplates grant the player the {block.minecraft.conduit} effect while underwater."
		""
		"Leggings and boots grant the Dolphin’s Grace effect while underwater."
		""
		"{@pagebreak}"
		"{item.l2complements.poseidite_ingot} tools gain 50% increased attack damage and 20% increased attack speed underwater, and deal an additional 100% damage (multiplicative) to aquatic creatures and water-fearing creatures."
	]
	quest.5F4BF0D8936B370B.quest_desc: [
		"Tickets crafted with &e{Umamusume Crystal}&r can summon higher-tier {UmaMusu}"
		"(R {UmaMusu} Ticket can summon SR {UmaMusu})"
		"(SR {UmaMusu} Ticket can summon SSR {UmaMusu})"
	]
	quest.5F69670FBE1B5FE4.quest_desc: [
		"Combine a photo with &6{item.minecraft.brown_dye}&r to obtain a photo with a more vintage style."
		""
		"Hold a photo in your inventory and right-click it onto another photo to stack them together into a pile."
	]
	quest.605639A83B5AE2B9.quest_desc: [
		"Armor Effect: Silence (&9When wearing 4 pieces of equipment with the Silence effect, any vibrations caused by the player will be nullified&r)"
		""
		"When wearing one piece, grants immunity to: Blindness, Darkness, Mining Fatigue, Nausea, Slowness, Weakness."
		""
		""
		"{@pagebreak}"
		"Sculk tools can &d break any destructible block at a relatively fast speed&r, ignoring hardness and mining level."
		""
		"Efficiency enchantments can further increase mining speed."
		""
		"&oWhen mining blocks, pay attention to the required tool and mining level. If the tool is incorrect or the mining level is insufficient, no drops will be obtained.&r"
	]
	quest.605639A83B5AE2B9.quest_subtitle: "Armor and Tools"
	quest.60BA9FC4C0678513.quest_desc: [
		"&6{item.exposure.interplanar_projector}&r is a special &6{item.exposure.camera}&r filter that can capture images from another dimension and turn them into photos (you can upload local images and shoot them as photos)."
		"First, rename &6{item.exposure.interplanar_projector}&r using &6{block.minecraft.anvil}&r or similar methods to the file path of a local image, e.g., D:/Images/cat.jpg. Supported formats include png, jpg, bmp, gif (static only), and transparency is supported (pixels must be fully transparent). Note that renaming items in &6{block.minecraft.anvil}&r has a length limit. If renamed as a URL path, it can also fetch images from the web."
		""
		"If projection fails, the projector will not be consumed but instead become a damaged &6{item.exposure.interplanar_projector}&r, which will display a blue screen error code in &6{item.exposure.camera}&r. A damaged projector can be repaired by combining it with &6{item.minecraft.ender_eye}&r."
	]
	quest.60F0E62C7A268D3D.quest_desc: [
		"You can use {item.l2hostility.miracle_powder} or {item.l2hostility.chaos_ingot} to craft &d{item.c6c.abyssal_ticket}&r"
		"Using &d{item.c6c.abyssal_ticket}&r at the home of &c{entity.irons_spellbooks.fire_boss}&r will open the &d{Abyssal Carnival}&r"
		"It may drop equipment of Normal, &bExcellent&r, &9Rare&r, &dLegendary&r, &6Epic&r, and &zMythical&r tiers, providing massive attribute bonuses"
		""
		"Once you complete the challenge and obtain the &l&b{item.irons_spellbooks.arcane_rune}&r&r, you can craft {block.irons_spellbooks.cinderous_soul_rune} to open the &d{Abyssal Carnival}&r challenge in the Overworld"
		""
		"&o{Abyssal Carnival} is not affected by {item.l2hostility.greed_of_nidhoggur}&r"
		"&oMost magic damage in {Abyssal Carnival} is not immune to {item.l2hostility.ring_of_divinity}&r"
		"&o{Abyssal Carnival} will not spawn BOSSes with &4{trait.l2hostility.dispell}&r&o or &4{trait.l2hostility.reprint}&r&o traits&r"
		""
		"Difficulty Level: 350+"
	]
	quest.620DE65D4B2B3547.quest_desc: [
		"The nether equivalent of &c{block.farmersdelight.rich_soil_farmland}&r. Becomes hydrated with open flames (&c{block.minecraft.fire}&r, &c{block.minecraft.lava}&r, &c{block.minecraft.torch}&r, &c{block.minecraft.lantern}&r, &c{block.minecraft.campfire}&r, &c{block.farmersdelight.stove}&r, &c{block.mynethersdelight.bullet_pepper}&r etc.) instead of water."
		""
		"Each open flame source hydrates &c{block.mynethersdelight.resurgent_soil_farmland}&r situated within a volume of 17x9x17 blocks from it."
		""
		"Hydrated &c{block.mynethersdelight.resurgent_soil_farmland}&r has a light level of 10, enough for most crops."
	]
	quest.62F46A2AF56A5FD6.quest_desc: ["Can be placed as a stand for &6{item.exposure.camera}&r, or held directly for taking photos."]
	quest.631002556817F054.quest_desc: ["Consuming {item.umapyoi.cupcake} increases Motivation Level by 1 and restores 5 hunger points and 6 saturation."]
	quest.639AE612BBE4F363.quest_desc: [
		"Using the initial &6{item.touhou_little_maid.smart_slab}&r can release an unowned maid"
		""
		"You can use &d{block.minecraft.cake}&r to tame an unowned maid"
		""
		"In single-player mode, you can change the maid’s model"
		"In servers, you cannot change the maid’s model"
		""
		"Collecting different maid combinations grants different buffs"
		"Collection statistics are based on the maid at the time of taming"
		""
		"You can also exchange unowned maids with server partners using &6{item.touhou_little_maid.smart_slab}&r"
	]
	quest.6724A17ED66D090E.quest_desc: [
		"Can be used for infinite mining of ores"
		"Search @ore in JEI to see all ore veins and their distribution locations"
	]
	quest.67F1D38FF93B5199.title: "Enter &4{dimension.minecraft.the_nether}&r"
	quest.6802763D2F467790.quest_desc: [
		"Located within the &aNether&r at the &6&lBurning Arena&r&r"
		"Structure ID: cataclysm:burning_arena"
	]
	quest.6802763D2F467790.quest_subtitle: "Difficulty800"
	quest.6954E808A764BB6D.quest_desc: [
		"&6{itemGroup.create_hypertube}&r placement works similarly to &6{block.create.track}&r. Once the track network is built, provide sufficient &6{create.display_source.kinetic_stress.current}&r to both ends of the &6{block.create_hypertube.hypertube_entrance}&r to put it into use."
		"By default, players only need to approach the &6{block.create_hypertube.hypertube_entrance}&r to enter and begin their journey."
		"Use &6{item.create.wrench}&r to adjust its mode. In auto-close mode, sneaking prevents entry into the hypertube; in manual-close mode, sneaking is required to enter."
	]
	quest.69F8F1E623EFEEF8.quest_desc: [
		"The Trial Hall lurks beneath the {biome.c6c.end_flower_forest}"
		"Other than that, the {biome.c6c.end_flower_forest} is peaceful and tranquil, with no particular danger"
	]
	quest.6A76D1EBB43A2451.quest_desc: [
		"可以将法术卷轴敲在武器上，使玩家在手持该武器时可以释放该法术"
		""
		"将卷轴与对应等级墨水合成一个高一级的卷轴"
	]
	quest.6B28FC5FC8BCAB87.quest_desc: ["Automatically feed the player when they are carrying a backpack equipped with this upgrade."]
	quest.6B453132CFF68D96.quest_desc: [
		"BOSS &c{entity.irons_spellbooks.fire_boss}&r Summoning Item"
		"Appears with a 1.5% chance in chests within {dimension.minecraft.the_end}"
		""
		"You can use it to craft a map to search for &c{entity.irons_spellbooks.fire_boss}&r in the &4{dimension.minecraft.the_nether}&r"
		""
		"Difficulty Level: 250+"
	]
	quest.6D54EE1C48F02762.quest_desc: [
		"可用于编辑玩家的法术书内含的法术。"
		"同一种法术无法被重复嵌入法术书中。"
	]
	quest.6DB3C1C6D21EA436.quest_desc: [
		"“&l&eMechanomania&r&r” is a modpack designed for: &aCreate Mod&r, &6Building&r, &cAdventure Players&r, and intended for &bMultiplayer&r&dLong-term&r servers."
		"Since there is no means of teleportation in the early stages, and in order to obtain resources, you may need to travel to different biomes to build mining machines and mob farms. Playing solo may feel like &lbeing imprisoned&r."
		""
		"If you are an &eAdventure Player&r and have confidence in your PVE skills, you can directly proceed to read the “&dThe End - Combat and Adventure&r” chapter."
		""
		"Thanks to the “JSI制作组” for their assistance in creating the quest book for the modpack. Without them, I would not have been able to complete this quest book."
		"Thanks to “老King呀老King” for the modpack playtesting and promotion."
		"Thanks to NaraZX and Staples17 for creating the zh-cn localization."
		"Thanks to ティオムTEOM for creating the en-us and th-th localization."
		"                                                             -MoePus 2025.07.29"
		""
		"&a&lNext Page&r&r"
		""
		"{@pagebreak}"
		""
		"&a&lServer Configuration Selection Guide&r&r"
		""
		"13700K + 8GB can support more than 8 players"
		"13900K + 16GB can support more than 10 players + DH"
		"Xeon and other server-grade CPUs can support 4 players"
		""
		"If DH is enabled, the server requires at least 12GB of memory!"
		""
		""
		""
		""
		""
		""
		"{@pagebreak}"
		""
		"&a&lAbout Shaders and Rendering&r&r"
		""
		""
		""
		""
		""
		""
		"Shaders with the suffix &6Clrwl&r include exclusive optimizations for Create Mod. If you use other shaders, you may experience a decrease in frame rate."
		""
		"If you encounter the issue where chests and Create Mod components&c cannot be displayed&r, follow the steps below:"
		"1. Make sure you are using a dedicated graphics card"
		"2. Make sure your graphics card driver is up to date"
		"3. Execute the command /flywheel backend instancing"
		"4. Execute the command /flywheel backend off"
		"Once one step takes effect, there is no need to execute the next step."
		"This issue is commonly seen with Intel graphics cards and AMD RDNA2 architecture graphics cards."
		""
		"{@pagebreak}"
		"&a&lC6C&r&r"
		"The C6C mod is the core customized module of the modpack. It provides some configuration options in c6c-common.toml, which you can modify as needed."
		"* Monster spawn rate in the Overworld"
		"* Monster spawn rate in the End"
		"* Disable changing maid skins in server environments"
		"* Double jump"
		""
		"{@pagebreak}"
		"&a&lReport a Crash&r&r"
		"If you encounter crashes or similar issues, please upload the crash report to"
		"&ehttps://mclo.gs/&r"
		"and send the generated link to the author"
	]
	quest.6DB3C1C6D21EA436.title: "Welcome to the &l&eMechanomania&r&r Modpack"
	quest.6F343418CE247D0D.quest_desc: [
		"Horse: The horse’s speed is twice that of vanilla, and it can ignore most terrain obstacles, running swiftly. &c{item.horseman.copper_horn}&r can summon a tamed horse."
		""
		"&c{item.usefulslime.slime_boots}&r and &c{item.usefulslime.slime_sling}&r: Allow the player to super jump and move quickly."
		""
		"&c{@create_hypertube}&r:Allows the player to move quickly over short distances within the base."
		""
		"&c{item.c6c.recall_potion}&r: Allows the player to quickly return to the bed or spawn point (cannot be used in the End)."
		""
		"Train (Mid-game): Can connect distant bases and resource points."
		""
		"&c{item.l2complements.fragile_warp_stone}&r (Mid-game): Allows the player to teleport to a designated marked location."
		""
		"&c{item.irons_spellbooks.hither_thither_wand}&r and &c{block.irons_spellbooks.portal_frame}&r (Late-game): Allow the player to teleport between two points."
	]
	quest.6F343418CE247D0D.title: "About Traveling the world"
	quest.6F4F862CB6AF1A4C.quest_desc: ["Consuming {item.umapyoi.hachimi_mid} increases Mood Level by 1 and restores 2 hunger points and 3 saturation."]
	quest.6F4F862CB6AF1A4C.quest_subtitle: "Can be consumed even at full hunger"
	quest.6FF2FBFB5A8D4C13.quest_desc: ["&oIn &c{dimension.minecraft.the_end}&r, the broom’s movement ability is severely restricted. This can be adjusted through the C6C configuration file&r"]
	quest.6FF2FBFB5A8D4C13.quest_subtitle: "You need a maid to sit with you"
	quest.6FF2FBFB5A8D4C13.title: "Flying Broom"
	quest.717036CE2862E3FF.quest_desc: ["When mining blocks or attacking entities, replace any tools in the player's primary hand with the best available tools or weapons."]
	quest.7190D0D53DB975B2.quest_desc: [
		"You can check other chapters of “{dimension.minecraft.the_end}” to decide your adventure plan"
		"Once decided"
		"Set off!"
	]
	quest.7199171C6EEE34F6.title: "Clone Blueprint"
	quest.73983F6255308C0E.quest_desc: [
		"Standing in the fluid of &6{item.hotbath.milk_bath_bucket}&r will restore health at a rate of 0.25 every 2 seconds."
		""
		"After standing in the fluid of &6{item.hotbath.milk_bath_bucket}&r for 15 seconds, all negative status effects will be removed except &c{effect.minecraft.unluck}&r."
		""
		"Standing in the fluid of &6{item.hotbath.milk_bath_bucket}&r will restore hunger at a rate of 1 every 15 seconds."
	]
	quest.74C40A81C9605AC0.quest_desc: [
		"The {End Deep Dark} biome is absolutely the &4most dangerous&r place in {dimension.minecraft.the_end}"
		"Two monsters, &d{entity.minecraft.warden}&r and &d{entity.irons_spellbooks.dead_king}&r, dwell here"
		"Fortunately, both of them are in a slumbering state"
		"As long as no one awakens them, they will remain asleep forever"
		""
		"&d{entity.minecraft.warden}&r and &d{entity.irons_spellbooks.dead_king}&r"
		"Which one is the truly owner of the deep dark?"
		""
		"Difficulty Level: 100+"
	]
	quest.74C40A81C9605AC0.title: "Shh! Keep Quiet!"
	quest.74F2404B036CB503.quest_desc: [
		"{Ancient City} occasionally appears in the Deep Dark biome of {dimension.minecraft.the_end}"
		""
		"It contains large amounts of &cNetherite&r, as well as materials for crafting the &dSoulbinding&r enchantment, such as &d{item.minecraft.echo_shard}&r. However, here also much more dangerous."
		""
		"Difficulty Level: 150+"
	]
	quest.74F2404B036CB503.title: "{Ancient City}"
	quest.75BA253A92043A09.quest_desc: [
		"This is the eerie biome of the End"
		"Everywhere you look, it’s lush and green"
		"&d{entity.minecraft.enderman}&r and &2{entity.minecraft.creeper}&r dwell here"
		"It is rich in &a{item.kubejs.chlorophyte_ingot}&r, which can be used to craft all kinds of new equipment and items"
		"If you want to survive on the outer islands of the End, &a{item.kubejs.chlorophyte_ingot}&r is essential"
		""
		"Difficulty Level: 20+"
	]
	quest.77305B767FC35FD7.quest_subtitle: "Enough said, let’s cook."
	quest.78158AE15F2A7180.quest_desc: [
		"Located within the &aOverworld&r at the &1&lSunken City&r&r"
		"Structure ID: cataclysm:sunken_city"
	]
	quest.78158AE15F2A7180.quest_subtitle: "Difficulty300"
	quest.7A3169F8A7713383.quest_desc: [
		"Transforms any backpack into a fully functional jetpack with flight and hovering capabilities;"
		"Uses {item.create.copper_backtank}/{item.create.netherite_backtank} as fuel (must be inside the backpack)."
	]
	quest.7A9D46939AA33A20.title: "More Refined"
	quest.7ADA92302AD2425C.quest_desc: [
		"&cNow, the {stronghold} is generated directly underground at coordinates 0,0 in the Overworld, and the portal to {dimension.minecraft.the_end} is automatically opened&r"
		""
		"&l&4The difficulty of {dimension.minecraft.the_end} is extremely high, it is recommended to go as a team.&r&r"
	]
	quest.7ADA92302AD2425C.title: "Go to {dimension.minecraft.the_end}"
	quest.7B75EE328291ABCC.quest_desc: ["I hope you can cultivate the most powerful {UmaMusu}!"]
	quest.7CD24C618C37D5C2.quest_desc: [
		"There are mainly two ways to obtain &d{item.l2hostility.chaos_ingot}&r"
		""
		"1. Crafting with a recipe"
		"2. Create a &b{item.l2hostility.charm_of_looting_4}&r, then go to the &c{End City}&r at difficulty level 200+. At this time, shulkers will always carry the {trait.l2hostility.dispell} trait, with a chance to drop &d{item.l2hostility.chaos_ingot}&r"
	]
	quest.7D783507714BF010.quest_desc: [
		"The altar can be built using red wool (20 pieces) and oak wood (18 pieces). After construction, right-click the blue position shown below with Hakurei’s gohei to generate the altar. By consuming &6{item.touhou_little_maid.power_point}&r, it can synthesize items and trigger specific events, and can also serve as energy for the &6{block.touhou_little_maid.maid_beacon}&r."
		""
		"After building according to the diagram, right-click the pillars to place items, Shift+right-click to remove items. When placed correctly, sufficient &6{item.touhou_little_maid.power_point}&r will be consumed to directly synthesize items or trigger specific events."
		""
		"Please check the entry &6{patchouli.touhou_little_maid.book.entries.overview.multiblocks_altar.name}&r in the guidebook &6{patchouli.touhou_little_maid.book.name}&r. Clicking the eye button will generate a visual projection."
		"{image:ftbquests:textures/nvpujitian.png width:160 height:120 align:center}"
	]
	quest.7D783507714BF010.title: "{touhou_little_maid.ponder.altar.header}"
	quest.7DB3025A320096D6.quest_desc: [
		"&c{End City}&r floats above the islands of &c{dimension.minecraft.the_end}&r"
		"Be careful, don’t slip! Below lies the endless abyss."
		""
		"Difficulty Level: 50+"
	]
	quest.7DB3025A320096D6.title: "Where the Ruins Lie"
	quest.7DF40621D9ECBE60.quest_desc: [
		"Effective when worn on the player's back or placed on the floor;"
		"Drags the item from outside a maximum of 5 blocks into the main storage slot of the backpack."
	]
