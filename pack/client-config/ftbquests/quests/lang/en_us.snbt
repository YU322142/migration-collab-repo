	quest.000EAE75E8F04497.quest_desc: [
		"When using, you first need to place &6{item.exposure.developed_black_and_white_film}&r or &6{item.exposure.developed_color_film}&r in the left slot. These allow you to print black-and-white photos or color photos respectively."
		""
		"Clicking the left/right positions lets you select the previous/next negative. Clicking the current negative or scrolling upward with the mouse wheel allows you to zoom in and view that negative in detail."
		""
		"After inserting &6{item.minecraft.paper}&r and dyes, click the print button to start the printing process. At this time, the red indicator light on the texture of &6{block.exposure.lightroom}&r will light up. Printing a black-and-white photo consumes one &6{item.minecraft.paper}&r and one 'minecraft:black_dye'; printing a color photo consumes one &6{item.minecraft.paper}&r and one of each of the four dyes, and also takes more time."
	]
	quest.000EAE75E8F04497.quest_subtitle: "Print out your photos!"
	quest.023C81F541EAFB0D.quest_desc: [
		"Congratulations on slaying the servant of {dimension.minecraft.the_end} - &d{entity.minecraft.ender_dragon}&r"
		"Now, stronger monsters await you on the outer islands of {dimension.minecraft.the_end}"
	]
	quest.02C7A69D089135C3.title: "Transmission Device"
	quest.05254E5479383C89.title: "Power Source"
	quest.053B7489051084E1.quest_desc: [
		"Standing in the fluid of &6{item.hotbath.rose_bath_bucket}&r will restore health at a rate of 0.25 per second,"
		"After standing in the fluid of &6{item.hotbath.rose_bath_bucket}&r for 15 seconds, all negative status effects will be removed."
		"After standing in the fluid of &6{item.hotbath.rose_bath_bucket}&r for 15 seconds, you will gain Level 1 &6{effect.minecraft.strength}&r effect, lasting for 20 seconds."
	]
	quest.06486C7C061D349B.quest_desc: [
		"After defeating &d{entity.minecraft.ender_dragon}&r, the &5{block.minecraft.end_gateway}&r will generate"
		"It will teleport the player to a &drandom location&r on the outer islands"
		"The outer islands of {dimension.minecraft.the_end} produce valuable items:"
		"- &6{item.minecraft.potion.effect.apothic_attributes.flying}&r"
		"- &6{block.minecraft.netherite_block}&r"
		"- &2{item.kubejs.chlorophyte_ingot}&r"
		"- &2{item.umapyoi.jewel}"
		""
		"However"
		"Since it is difficult for players to return to their last death location"
		"Dropped items are almost permanently lost."
		""
		"&o&5{block.minecraft.end_gateway}&r has a 5-minute cooldown. Entering during cooldown will not refresh the exit location but will reset the cooldown, making team exploration easier&r"
		"&oThere is no player-to-player damage between the {dimension.minecraft.the_nether} and {dimension.minecraft.the_end}&r"
	]
	quest.06486C7C061D349B.title: "Outer Islands"
	quest.068BF44B149A3415.quest_desc: ["The Nether version of &c{block.farmersdelight.organic_compost}&r. Can only be transformed into &c{block.mynethersdelight.resurgent_soil}&r within the Nether."]
	quest.0878F69BAFB5F301.quest_desc: [
		"Reward: Permanent [&6{effect.kaleidoscope_cookery.vigor}&r] BUFF: "
		"  Sprinting does not consume saturation"
		""
		"&oYou can view all collectible items and rewards in the achievement “&c{advancement.c6c.root}&r”"
	]
	quest.0878F69BAFB5F301.quest_subtitle: "Collect all types of &6{model.geckolib.zhiban.name}&r maids"
	quest.0BDB2241B517EC3E.quest_desc: [
		"放置墨水，墨水的品质决定卷轴的品质。"
		""
		"放置纸，书写一张卷轴需要消耗一张纸。"
		""
		"放置材料，材料决定法术学派。"
		""
		"放置材料后，会显示出可撰写的法术。部分法术可能会显示问号图样，尝试使用更高等级的墨水来撰写。"
		""
		"撰写完毕的卷轴位于此处。注意，只有鼠标左键将其拿出才会消耗原材料。"
		""
		"可撰写法术卷轴"
		"法术卷轴也可以从战利品箱中获得或击杀死者之王"
		"也可以与流浪商人/火焰术士/药剂师交易获得"
	]
	quest.0C04B0D91BB46687.quest_desc: [""]
	quest.0C04B0D91BB46687.quest_subtitle: "Place it in the {curios.identifier.uma_suit} slot"
	quest.0C04B0D91BB46687.title: "Dress your {UmaMusu} in new clothes"
	quest.0D10CBCC2332A0A0.quest_desc: ["&e&lAutomated logistics assistant&r&r across long distances within the same dimension"]
	quest.0D70527CD0560FA3.quest_desc: [
		"{dimension.minecraft.the_end} outer islands will spawn monsters with &dhostility&r"
		"&lAs players kill more monsters&r"
		"The monsters’ attributes will become stronger"
		"They will gradually begin to gain {trait}"
		"For example:"
		"- &d{trait.l2hostility.blindness}&r"
		"- &d{trait.l2hostility.levitation}&r"
		""
		"                    --> Next Page"
		"{@pagebreak}"
		"You can always check the current difficulty level on the difficulty page above your inventory"
		"Be careful not to let the difficulty exceed your capability too much!"
		"Before your life is in danger, find a portal to evacuate the {dimension.minecraft.the_end} outer islands"
		"When you re-enter the {dimension.minecraft.the_end} outer islands next time"
		"Monster strength will automatically readjust"
		""
		"If the player dies"
		"Monster strength will be reset"
		""
		"&o&lCannot use &5{item.c6c.recall_potion}&r in &c{dimension.minecraft.the_end}&r "
	]
	quest.0E0AA6FDAB840DA8.title: "{container.fxntstorage.simple_storage_box_title}upgrade"
	quest.0E98873F2A744F77.title: "Your First Machine"
	quest.0EAED4471D8CE8AC.quest_desc: [
		"Shift + Right-click &6{item.exposure.camera}&r to open the internal GUI of &6{item.exposure.camera}&r and install the required components, including &6{film}&r, Flash, Lens, and filters. You can also directly right-click &6{item.exposure.camera}&r with the corresponding item to install or replace components."
		"(If &6{item.exposure.camera}&r is placed on a tripod, please stand a bit farther away before Shift + Right-click to avoid triggering &6{carryon}&r pickup.)"
		""
		"&6{film}&r: Various undeveloped &6{film}&r"
		"Flash: &6{block.minecraft.redstone_lamp}&r"
		"Lens: &6{item.minecraft.spyglass}&r"
		"Filter: Various stained glass panes / &6{item.exposure.interplanar_projector}&r"
	]
	quest.0EAED4471D8CE8AC.quest_subtitle: "Capture beautiful moments"
	quest.0EC90EBB03243D94.quest_desc: [
		"&6{block.torchmaster.feral_flare_lantern}&r will detect the light level of each block within a 16-block radius sphere. If a block’s light level is less than 7, &6{block.torchmaster.feral_flare_lantern}&r will attempt to place an invisible light source with a brightness of 11 nearby."
		""
		"To achieve maximum efficiency, the ideal lighting method is to place one &6{block.torchmaster.feral_flare_lantern}&r approximately every 30 blocks."
	]
	quest.0F5E82B5594F0725.quest_desc: ["Prevents players from taking fall damage while carrying a backpack."]
	quest.114E23CD35C37E9B.quest_desc: ["Consuming {item.umapyoi.sweet_cupcake} increases Motivation Level by 2 and restores 7 hunger points and 9 saturation."]
	quest.1169390015BB59F9.title: "Engineer Essentials"
	quest.1171B51ED997D998.quest_desc: [
		"Reward: Permanent “&a{effect.minecraft.luck}&r” BUFF"
		""
		"You can press [&bL&r] in the game interface to open the achievements page"
		""
		"Find “&c{advancement.c6c.root}&r” to check the current maid collection progress"
	]
	quest.1171B51ED997D998.quest_subtitle: "Collect your first maid"
	quest.121E38D67771FEB0.quest_desc: [
		"You can customize your Golem."
		"And equip them with suitable gear."
	]
	quest.121E38D67771FEB0.title: "Golem Assembly"
	quest.12B2B927FFFFD3F1.quest_desc: [
		"自然生成于结构远古战场,炽焰术士塔中也会生成"
		""
		"需要钻石镐或以上挖掘等级来破坏，如果挖掘等级不足不会掉落物品并且生成远古骑士。"
		""
		"破坏后掉落大量铁粒，金粒，0-1个灰烬源质，低概率掉落一个下界合金碎片；"
		""
		"破坏后原地生成敌对生物远古骑士。"
	]
	quest.12B2B927FFFFD3F1.title: "散落的盔甲"
	quest.136C3B3FEB2ED0CC.quest_desc: [
		"&4Note:&r"
		"If you have installed the {YSM mod}, it &dmay cause the inventory to not display player armor&r"
		""
		"Solution: "
		"* Disable the display of {item.umapyoi.uma_soul} in the trinket slot"
		""
		"Or"
		""
		"* Press Alt+Y to open the YSM page"
		"At the wrench icon in the top right, select “{Prevents rendering of self player's model}”"
	]
	quest.136C3B3FEB2ED0CC.title: "YSM"
	quest.13B1E27BAA44F3B8.quest_desc: [
		"Because the mob spawn limit in the Overworld is low, the conditions for building a mob farm are not met. Players can build their own mob spawners, which can directly spawn monster loot into chests with low lag."
		"Similar to normal mob farms, different biomes will spawn different mobs (&a The types of mobs spawned are the same as in the original game&r)"
		""
		"input &d{block.create_mechanical_spawner.spawn_fluid_random}&r to start spawning monsters"
		""
		"&a&lNext Page&r&r"
		"{@pagebreak}"
		""
		"&l Mobs Spawning Reference&r"
		"Stray: frozen ocean, deep frozen ocean, snowy tundra, snowy taiga, snowy slopes"
		"Husk: Desert"
		"Magma cube: Nether Wastes, Basalt Deltas"
	]
	quest.14C82B046FCA091C.title: "Chunk Loading"
	quest.1534B59AA6AB4BD9.title: "Non-standard Transmission Device"
	quest.1566785ABC7FC6BC.quest_subtitle: "Multiblock Structure Packager"
	quest.1637D39489C22EB9.title: "{item.structurecompass.structure_compass}"
	quest.17E8B04D5E517FFD.quest_desc: [
		"Standing in the fluid of &6{item.hotbath.herbal_bath_bucket}&r will restore health at a rate of 0.25 every 2 seconds."
		"After standing in the fluid of &6{item.hotbath.herbal_bath_bucket}&r for 15 seconds, all negative status effects will be removed."
		"After standing in the fluid of &6{item.hotbath.herbal_bath_bucket}&r for 5 seconds, you will gain Level 1 &6{effect.minecraft.resistance}&r effect, lasting for 10 seconds."
		"Undead creatures standing in the fluid of &6{item.hotbath.herbal_bath_bucket}&r will lose health at a rate of 0.5 per second."
	]
	quest.18DE4FF6E70319A5.quest_desc: [
		"In the inventory, when the mouse hovers over any item"
		"key R (Recipes): Display item recipes"
		"key U (Uses): Displays the item's purpose."
		"key A: Save an item so you can view the recipe later."
	]
	quest.18DE4FF6E70319A5.title: "Check item recipes"
	quest.1A84011D71AF4A87.quest_desc: [
		"Once you possess &e{item.umapyoi.crystal_gold}&r"
		"You can craft &e{block.umapyoi.uma_pedestal}&r"
		""
		"You can only with it summon SSR {UmaMusu} and SSR {Support Card}"
	]
	quest.1B12A06587207CCB.quest_desc: ["Refill your main hand item or off-hand item (if any) from your inventory."]
	quest.1B7A31081B34C2D0.quest_desc: [
		"Once you possess &d{item.umapyoi.skill_book}&r, you can &aTrain&r {UmaMusu} at the {block.umapyoi.skill_learning_table}"
		""
		"After &aTraining&r, the attributes of {UmaMusu} will be greatly enhanced!"
		""
		"{item.umapyoi.skill_book} can be found in chests within {dimension.minecraft.the_end}"
	]
	quest.1BBF920628E5D7D8.quest_desc: [
		"Craft a &6{block.kaleidoscope_doll.doll_machine}&r to pull for a maid"
		""
		"Each draw has a 100% chance to obtain a doll,"
		"and a 12% chance to obtain a &6{item.touhou_little_maid.smart_slab}&r containing a maid"
	]
	quest.1E997C93EDDBD107.quest_desc: [
		"You have obtained &a{item.kubejs.chlorophyte_ingot}&r"
		"It can be used to craft the following ingots"
		""
		"Those ingots can be used to craft {l2complements.title} equipment. All of this equipment has powerful effects or set bonuses"
		""
		"&d&lThere are also two other ways to obtain {l2complements.title} equipment:&r&r"
		"* Directly upgrade &bDiamond·Netherite&r equipment"
		"* Use &e{item.irons_spellbooks.timeless_slurry}&r to upgrade Netherite equipment"
	]
	quest.1F18639774CCF28E.quest_desc: [
		"Use &d{item.umapyoi.blank_ticket}&r on the {block.umapyoi.silver_uma_pedestal} (note: your off-hand must be empty)"
		"You will then obtain &e{item.umapyoi.blank_uma_soul}&r"
		""
		"Next, place &e{item.umapyoi.blank_uma_soul}&r into the &b{block.umapyoi.three_goddess}&r to receive &b{item.umapyoi.uma_soul}&r"
		""
		"Equip &b{item.umapyoi.uma_soul}&r in your trinket slot to gain &6attribute boosts&r!"
	]
	quest.1F829C67174A4944.quest_desc: [""]
	quest.20C36E1FC5B0C4EF.title: "Next, you can build an elevator to decorate your house"
	quest.2105773288B818A7.title: "Advanced Logistics"
	quest.21A14597E092B4EC.title: "Train Transport Package"
	quest.225EE2F819DD7B94.quest_desc: ["Upon consumption, restores 2 hunger points and 2.4 saturation, while also recovering stamina equal to a percentage of the maximum stamina."]
	quest.23C25A1C2A64D98A.quest_desc: [
		"First, use the {block.minecraft.dragon_head} dropped by &d{entity.minecraft.ender_dragon}&r to craft a &b{block.alloy_smelter.forge_controller_tier3}"
		"It can increase your ore yield, and more importantly, it can smelt and digest various products from the {dimension.minecraft.the_end} outer islands"
	]
	quest.245F475CE17B31BE.title: "Building Assistant"
	quest.2513F6677A477C78.quest_desc: [
		"要塞会直接生成在坐标0，0处地下。并且自动开启末地传送门。"
		""
		"你可以直接前往末地开始冒险。"
		""
		"由于末地难度极高，建议组队前往"
	]
	quest.253789D53CF7F585.quest_desc: [
		"Located within the &5End&r at the &d&lRuined Citadel&r&r"
		"Structure ID: cataclysm:ruined_citadel"
	]
	quest.253789D53CF7F585.quest_subtitle: "Difficulty100"
	quest.254B565D5CB0CD9D.quest_desc: [
		"Different ores are densely distributed in different biomes."
		"For example, plains may contain a large number of iron ore veins, while windswept hills may contain a large number of &c{block.kubejs.compressed_tuff}&r veins."
		"Some ore veins require &bCoolant&r, which can only be mined in cold biomes."
		"&cCopper &rand &czinc &rcan be obtained by crushing &c{block.kubejs.compressed_tuff}&r."
		""
		"Almost any ore can be mined."
		"&dSearch &a@ore&r on JEI to get all mineral vein information.&r"
	]
	quest.2765F1D3D9529A27.quest_desc: ["Standing in the hot spring bath for 15 seconds grants a Level 1 &6{effect.minecraft.speed}&r effect for 20 seconds."]
	quest.2813FF8C41AFEF22.quest_desc: ["You can find a large number of &5{block.irons_spellbooks.brazier_soul}&r here"]
	quest.2813FF8C41AFEF22.title: "Serene Ice Garden"
	quest.295B71FE3F4848D6.quest_desc: [
		"Reward: Permanent [&a{effect.farmersdelight.nourishment}&r] BUFF: "
		"  When not taking damage, &d&lno hunger or saturation will be consumed&r&r"
		""
		""
		"&oYou can view all collectible items and rewards in the achievement “&c{advancement.c6c.root}&r”"
	]
	quest.295B71FE3F4848D6.quest_subtitle: "Collect all types of &6{Wine Fox}&r maids"
	quest.29641835AFA986E4.quest_desc: [
		"Extremely high durability, not easily damaged."
		""
		"At most 1 point of durability loss at a time."
		""
		"When the player is invisible, the armor also becomes invisible."
		""
		"{@pagebreak}"
		"When the player is invisible, tools also become invisible."
		""
		"Attack range and mining range +1"
	]
	quest.29641835AFA986E4.quest_subtitle: "Armor and Tools"
	quest.298F765A538085EE.quest_desc: ["Consuming {item.umapyoi.royal_bitter} fully restores stamina, and recovers 2 hunger points and 3 saturation, but decreases Motivation Level by 1."]
	quest.2B4E14697A217391.quest_desc: [
		"Reward: Permanent [&aReach Distance +1&r]"
		""
		"&oYou can view all collectible items and rewards in the achievement “&c{advancement.c6c.root}&r”"
	]
	quest.2B4E14697A217391.quest_subtitle: "Collect 5 maids"
	quest.2B88D9C4FF3F9C1E.quest_desc: [
		"Craft a &6{block.irons_jewelry.jewelcrafting_station}&r"
		"You can use it to create various accessories, enhancing your &6attributes&r"
	]
	quest.2CC6203A4CCE5D19.quest_desc: [
		"The maid can be cute, cook, and even crank a hand crank. Depending on the level of affection, she can provide any amount of &c{create.display_source.kinetic_stress.current}&r between 4096 and 65536."
		""
		"The maid also features a collection element, and &crewards players with powerful buffs such as increased player stats and never getting hungry&r. Please refer to the “Touhou Little Maid” chapter in the quest book."
	]
	quest.2CCE21B461C8DF85.quest_desc: [
		"Similar to a magnet upgrade, but with a relatively limited range;"
		"Items picked up by players will be stored in the backpack instead of the inventory itself."
	]
	quest.2DACA9D43F90D423.quest_desc: [
		"Items from {itemGroup.umapyoi} are one of the most important outputs of &c{dimension.minecraft.the_end}&r"
		""
		"A trained {item.umapyoi.uma_soul} can &c greatly enhance your attributes&r"
		"Please refer to the {itemGroup.umapyoi} chapter in other mods"
		""
		"Be careful not to lose &e{book.umapyoi.trainers_manual.title}&r, as it can be crafted into a &d{item.umapyoi.blank_ticket}&r"
	]
	quest.2F179AA3C20F87C6.quest_desc: [
		"When water or lava reaches 10,000 blocks, &6{block.create.hose_pulley}&r will treat it as infinite fluid, allowing unlimited extraction"
		""
		"When placing fluid, &6{block.create.hose_pulley}&r must be above the target fluid surface."
		"When extracting fluid, &6{block.create.hose_pulley}&r must be at the bottom of the target fluid."
	]
	quest.315C4FF982B23FBE.quest_desc: ["Place &7{block.umapyoi.silver_uma_pedestal}&r and &b{block.umapyoi.three_goddess}&r into the world"]
	quest.324AB45A0A0B05A4.quest_desc: [""]
	quest.324AB45A0A0B05A4.title: "{item.naturescompass.naturescompass}"
	quest.3282EB41DB52504C.quest_desc: [""]
	quest.3370CAF47A5F8EBD.quest_desc: [
		"You need to prepare 4 &a{item.umapyoi.jewel}&r"
		"to craft &7{block.umapyoi.silver_uma_pedestal}&r and &b{block.umapyoi.three_goddess}&r"
	]
	quest.3454BE7CF82A56B4.quest_desc: ["This is one of the drops from &d{entity.irons_spellbooks.dead_king}&r"]
	quest.356B1B423D318A77.quest_desc: [
		"You can obtain brand-new jewelry scrolls from various ruins in {dimension.minecraft.the_end} or {dimension.minecraft.the_nether}"
		"Learn them"
		"You will be able to craft more powerful jewelry"
	]
	quest.35BFF10E665799C5.quest_desc: ["You need to use {item.irons_spellbooks.mithril_ingot} to craft a 15-minute {item.minecraft.potion.effect.apothic_attributes.flying}"]
	quest.35C67C49516C597B.quest_desc: [
		"Located within the &aOverworld&r at the &e&lCursed Pyramid&r&r"
		"Structure ID: cataclysm:cursed_pyramid"
	]
	quest.35C67C49516C597B.quest_subtitle: "Difficulty200"
	quest.35FAF22E1BE9187F.quest_desc: [
		"You can use &d{Support Card}&r to &aTrain&r {UmaMusu} at the {block.umapyoi.training_facility}"
		""
		"After &aTraining&r, the attributes of {UmaMusu} will be greatly enhanced!"
		""
		"Place a book on either the &7{block.umapyoi.silver_uma_pedestal}&r or the &6{block.umapyoi.uma_pedestal}"
		"Then you can use &d{item.umapyoi.blank_ticket}&r to summon &d{Support Card}&r"
	]
	quest.379E53FBABC20CC3.quest_desc: [
		"You can use &a{item.kubejs.chlorophyte_ingot}&r to craft brand new equipment, and enhance player attributes with “&c{itemGroup.umapyoi}&r” and “&cAccessories&r”."
		""
		"&lYou can use the shortcut key&r &6Shift + X&r &lto share the treasures you have obtained&r"
		""
		"&dYou can craft a book &a{patchouli.l2hostility.title}&r&d, which contains strategies for dealing with various enemies/&6&l{trait}&r&r&d"
		""
		"If you need more detailed process recommendations, please check the next page"
		""
		""
		"{@pagebreak}"
		""
		"You can go to the {dimension.minecraft.the_end} eerie biome, mine some {item.kubejs.chlorophyte_ingot} to craft {item.kubejs.chlorophyte_sword}, which has higher attack power and longer reach than a diamond sword (see the {dimension.minecraft.the_end} eerie chapter)."
		""
		"Then, head to the {dimension.minecraft.the_end} city to loot chests and craft “&c{itemGroup.umapyoi}&r” and “&cAccessories&r” to enhance player attributes. (See the {dimension.minecraft.the_end} islands chapter)."
		"Most accessories will not drop upon death. Each adventure in {dimension.minecraft.the_end} will provide growth for you."
		""
		"Next, go to the {dimension.minecraft.the_end} deep dark biome, find the ancient city, and use the looted materials to craft “&dSoul Binding Enchantment&r”. (One book is enough, you can use {itemGroup.create.base} machinery to duplicate enchanted books infinitely)."
		""
		"Then challenge {entity.irons_spellbooks.dead_king} in {dimension.minecraft.the_end} deep dark biome to learn magic."
		""
		"Finally, go to the trial hall in the {dimension.minecraft.the_end} flower forest to obtain the {l2hostility.title} {l2hostility.jei.loot_title}, and craft the items listed below in this chapter’s quest book."
		""
		"When you can easily wipe out level 300 monsters, you may try surviving longer in {dimension.minecraft.the_end}, until you encounter monsters with “{trait.l2hostility.killer_aura}” and “{trait.l2hostility.ragnarok}”."
		""
		"“{trait.l2hostility.killer_aura}” will periodically deal massive magic armor-piercing damage to nearby players."
		""
		"“{trait.l2hostility.ragnarok}” will seal the player’s accessories upon hitting them (except inventory and {itemGroup.umapyoi} accessories). You need to use the sealed accessories like food to lift the seal."
		"Craft a “{item.l2hostility.pocket_of_restoration}”, which will automatically remove the “{trait.l2hostility.ragnarok}” seal, greatly reducing the pressure of fighting against “{trait.l2hostility.ragnarok}” mobs."
		""
		"Make defeating monsters with “{trait.l2hostility.ragnarok}” your goal, and strive towards it."
	]
	quest.379E53FBABC20CC3.title: "Recommended Grinding Route"
	quest.38014DB8FC25BED2.quest_desc: [
		"Right-clicking the rope while holding it will place a new rope below."
		""
		"Right-clicking the rope while sneaking with it in hand will place a new rope in the area specified by the player's crosshair;"
		""
		"Right-clicking the rope while sneaking without hands will retrieve the rope to the player's inventory, starting from the bottom of the rope;"
		""
		"Two adjacent ropes will be visually connected."
		""
		"If a bell is directly above a rope, right-clicking these ropes (up to 24 blocks away from the bell) will ring the bell. The rope directly below the bell will be visually connected to the bell."
	]
	quest.38014DB8FC25BED2.quest_subtitle: "Hold down the spacebar to climb."
	quest.393188CC2575E3CF.quest_desc: [
		"It can help you increase mineral production"
		"At the same time, it has some unique recipes"
		""
		"You need to build this alloy smelter according to a &2multiblock structure&r"
		"Don’t worry, I’ve prepared a &bblueprint&r {(alloy_smelter.nbt)} for you"
		""
		"You can also refer to the diagram on the left for construction"
		"If you need &6automation&r, you can refer to the diagram on the right"
		""
		"Materials can be inserted into the controller from both sides, fuel from the front, and a hopper can be placed below to collect products"
		""
		"&dTier 1 Smelter uses: {item.minecraft.brick}&r"
		"&dTier 2 Smelter uses: {block.minecraft.polished_blackstone_bricks}&r"
		"&dTier 3 Smelter uses: {block.minecraft.end_stone_bricks}&r"
	]
	quest.3DBA88AAE97C7DE8.quest_desc: ["Drowned converted from zombies have a high chance of carrying tridents, which can be used to craft {item.l2complements.poseidite_ingot}"]
	quest.3DD1B51E6A581AA1.quest_desc: [
		"&c{block.farmersdelight.rich_soil_farmland}&r is obtained by right-clicking with a hoe and will not degenerate into &c{block.farmersdelight.rich_soil}&r due to trampling. It cannot be obtained with Silk Touch, but will drop &c{block.farmersdelight.rich_soil}&r after broken"
		""
		"Gives more frequent tick updating and a higher chance for increased growth rate for crops planted on it; on lucky circumstances, a planted seed can grow twice consecutively and be ready for harvest. The effect is more apparent for hydrated &c{block.farmersdelight.rich_soil_farmland}&r."
	]
	quest.3E3B9BAC8D0CC46C.quest_desc: ["Entity that falls onto the {block.farmersdelight.safety_net} will not receive fall damage and bounce back up (similiar to the original {block.minecraft.slime_block}). Crouching will negate this effect."]
	quest.3EB7A495A8443564.quest_desc: [
		"Head to the Trial Hall to challenge &2{block.minecraft.trial_spawner}&r"
		"Upon success, it may release a level 0–100 “{hostility}” {l2hostility.jei.loot_title}"
		""
		"If you have the &5{effect.minecraft.bad_omen}&r debuff..."
		"It will transform into an &dOminous {block.minecraft.trial_spawner}&r"
		"At the same time, it has a chance to release all “{hostility}” {l2hostility.jei.loot_title} at levels 0–299"
		""
		"Difficulty Level: 150+"
	]
	quest.3EB7A495A8443564.title: "{trait}！{trait}！"
	quest.4136927C252AD534.quest_desc: [
		"Use an axe to right-click logs to obtain stripped logs"
		"Then use &6{item.create.andesite_alloy}&r to right-click stripped logs to obtain &6{block.create.andesite_casing}&r"
	]
	quest.41602D65D7AC69EB.quest_subtitle: "Can be obtained from loot chests"
	quest.41602D65D7AC69EB.title: "More Wolf Armor"
	quest.41A7BD9935057245.quest_desc: [
		"Right-click {block.umapyoi.uma_statues} while holding {item.umapyoi.uma_soul} to display a static model of {UmaMusu}."
		""
