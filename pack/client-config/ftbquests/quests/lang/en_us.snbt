	quest.420F2FE9D30CFFC3.quest_subtitle: "Collect 20 maids"
	quest.43104742822CBF0C.quest_desc: [
		"Located within the &aOverworld&r at the &8&lAncient Factory&r&r"
		"Structure ID: cataclysm:ancient_factory"
	]
	quest.43104742822CBF0C.quest_subtitle: "Difficulty10"
	quest.43292FFEA3A7B2B4.quest_desc: ["If you don’t understand how the machine works, open your inventory, hold [&bW&r] while pointing at &6{Create Mod}&r components to ponder"]
	quest.43292FFEA3A7B2B4.quest_subtitle: "First Step of &6{Create Mod}&r"
	quest.4564BE69E51A90A4.quest_desc: [
